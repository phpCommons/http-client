{
    "name": "php-commons/http-client",
    "description": "HTTP client as wrapper for Guzzle 7",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michał Ligus",
            "email": "maveilthain@gmail.com"
        }
    ],
    "version": "1.0.0",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "guzzlehttp/guzzle": "^7.10",
        "netresearch/jsonmapper": "^5.0"
    },
    "require-dev": {
        "ext-json": "*",
        "phpunit/phpunit": "^12.0",
        "donatj/mock-webserver": "^2.1",
        "php-mock/php-mock-phpunit": "^2.10"
    },
    "autoload": {
        "psr-4": {
            "PhpCommons\\HttpClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        }
    }
}